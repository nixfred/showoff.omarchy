[Desktop Entry]
Version=1.0
Name=Showoff Omarchy
GenericName=Omarchy Demo
Comment=Show Omarchy off to a Windows or Mac person. Esc twice to stop.
Exec=showoff
Terminal=false
Type=Application
Icon=omarchy
Categories=Utility;
Keywords=demo;show;showoff;omarchy;
StartupNotify=false
Actions=record-x;

[Desktop Action record-x]
Name=Record the X cut (80 s, saves to ~/Videos)
Exec=showoff x
