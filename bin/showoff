#!/bin/bash
# showoff — Showoff Omarchy launcher.
# usage: showoff                 run the show (about 4 minutes, then it ends)
#        showoff x               the ~80 s cut for posting; records itself to ~/Videos
#        showoff act <id>[,<id>…] rehearse just those acts, in order
#        showoff prepare         install the optional packages the acts use (not built yet)
# Esc twice, at any time, stops it and puts everything back.
set -euo pipefail

app_dir="${SHOWOFF_APP_DIR:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)/app}"

usage() {
  sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'
}

mode="${1:-auto}"
case "$mode" in
auto | x) ;;
act)
  export SHOWOFF_ACT="${2:?usage: showoff act <id>}"
  ;;
prepare)
  echo "showoff prepare: not built yet. Optional packages are offered on screen during the show." >&2
  exit 2
  ;;
-h | --help | help)
  usage
  exit 0
  ;;
*)
  usage >&2
  exit 1
  ;;
esac

if ! command -v quickshell >/dev/null; then
  echo "showoff: quickshell not found. Showoff Omarchy needs Omarchy 4.0 or newer." >&2
  exit 3
fi
if [[ ! -f "$app_dir/shell.qml" ]]; then
  echo "showoff: app not found at $app_dir (set SHOWOFF_APP_DIR)" >&2
  exit 3
fi

export SHOWOFF_MODE="$mode"
# Our helpers (showoff-hypr) must be on PATH for the engine's commands.
bin_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
export PATH="$bin_dir:$PATH"
# A shell started outside the session (ssh, a resumed agent) may lack this.
export HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:-$(ls -t "/run/user/$(id -u)/hypr" 2>/dev/null | head -1)}
# -n: never start a second show on top of a running one.
exec quickshell -n -p "$app_dir"
